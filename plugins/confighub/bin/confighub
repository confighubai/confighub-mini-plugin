#!/bin/sh
# Runs the ConfigHub plugin's program for this machine: the one this plugin carries,
# or, when the plugin is the one inside the confighub mini package, the package's own.
here=$(cd "$(dirname "$0")" && pwd)
os=$(uname -s | tr 'A-Z' 'a-z')
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) arch=$(uname -m) ;;
esac
program=$here/confighub-$os-$arch
# The programs are kept compressed, four platforms being carried for the one that
# runs. This machine's is unpacked once, beside them or, where the plugin's folder
# cannot be written, in the person's own configuration.
if [ ! -x "$program" ] && [ -f "$program.gz" ]; then
  if ! { gzip -dc "$program.gz" > "$program.$$" && chmod +x "$program.$$" && mv -f "$program.$$" "$program"; } 2>/dev/null; then
    rm -f "$program.$$" 2>/dev/null
    sum=$(cksum < "$program.gz" | cut -d' ' -f1)
    dir=${CUB_CONFIG:-$HOME/.confighub}/plugin-programs
    program=$dir/confighub-$os-$arch-$sum
    if [ ! -x "$program" ]; then
      mkdir -p "$dir" && gzip -dc "$here/confighub-$os-$arch.gz" > "$program.$$" && chmod +x "$program.$$" && mv -f "$program.$$" "$program"
    fi
  fi
fi
if [ -x "$program" ]; then
  exec "$program" "$@"
fi
if [ -x "$here/../../bin/confighub-mini-app" ]; then
  exec "$here/../../bin/confighub-mini-app" "$@"
fi
echo "confighub: no program for $os/$arch in this plugin" >&2
exit 1
