#!/bin/sh
# Runs the minihub program for this machine: the one this plugin carries, or,
# when the plugin is the one inside the minihub package, the package's own.
here=$(cd "$(dirname "$0")" && pwd)
os=$(uname -s | tr 'A-Z' 'a-z')
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) arch=$(uname -m) ;;
esac
if [ -x "$here/minihub-app-$os-$arch" ]; then
  exec "$here/minihub-app-$os-$arch" "$@"
fi
if [ -x "$here/../../bin/minihub-app" ]; then
  exec "$here/../../bin/minihub-app" "$@"
fi
echo "minihub: no program for $os/$arch in this plugin" >&2
exit 1
