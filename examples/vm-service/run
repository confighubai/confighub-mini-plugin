#!/usr/bin/env python3
"""Run a real service on an existing OrbStack Linux VM, and check its gate.

VM_SERVICE_MACHINE=sam-vm CONFIGHUB_MINI_PACKAGE=... VM_SERVICE_LINUX_PACKAGE=... ./run
Only this run's hub, files, keys, services and timers are removed afterwards.
The approval is scripted by the owner's key; no agent session is simulated.
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import sys
import subprocess
import tempfile
import time
import uuid

here = Path(__file__).resolve().parent
flags = argparse.ArgumentParser(description=__doc__)
flags.add_argument("--agent", action="store_true", help="have a real Codex session build the API and propose its later hardening")
flags.add_argument("--interactive", action="store_true", help="show the proposal and ask the person in this terminal; never script their approval")
flags.add_argument("--model", help="the Codex model for this run")
flags.add_argument("--out", type=Path, help="keep the agent sessions and result here, outside the temporary sandbox")
options = flags.parse_args()
if options.interactive and not sys.stdin.isatty():
    flags.error("--interactive needs your terminal; no approval is inferred without it")
if options.out:
    options.out = options.out.resolve()
    options.out.mkdir(parents=True, exist_ok=False)
package = Path(os.environ["CONFIGHUB_MINI_PACKAGE"]).resolve()
linux = Path(os.environ["VM_SERVICE_LINUX_PACKAGE"]).resolve()
machine = os.environ.get("VM_SERVICE_MACHINE", "sam-vm")
run_id = uuid.uuid4().hex[:10]
app = "vmapp-" + run_id
hub = "vm-service-" + run_id
work = Path(tempfile.mkdtemp(prefix=".confighub-mini-vm-service-", dir=Path.home()))
cfg = work / "owner"
env = dict(os.environ, CUB_CONFIG=str(cfg), PATH=str(package / "bin") + os.pathsep + os.environ["PATH"])
for key in ("CUB_CONTEXT", "CUB_SERVER", "CLAUDE_PROJECT_DIR"):
    env.pop(key, None)
checks = []
remote = None
source = None
installed = False
complete = False
sessions = []
declined = False

class ApprovalDeclined(Exception):
    pass

def call(args, *, data=None, allowed=False, environment=None):
    p = subprocess.run([str(a) for a in args], input=data, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, env=environment, cwd=work, timeout=120)
    if p.returncode and not allowed:
        raise RuntimeError("%s failed: %s" % (args[0], p.stderr.decode(errors="replace")[-1200:]))
    return p

def vm(*args, **kwargs):
    return call(["orb", "-m", machine, *args], **kwargs)

def you(*args, **kwargs):
    return call([package / "bin/cub", *args], environment=env, **kwargs)

def agent(*args, **kwargs):
    e = dict(env, CUB_CONFIG=str(cfg) + "-agent-proposer", CUB_CONTEXT="proposer")
    return call([package / "bin/cub", *args], environment=e, **kwargs)

def agent_request(prompt):
    launcher = Path(str(cfg) + "-agent-proposer") / "run-codex"
    command = [str(launcher), "exec", "--skip-git-repo-check", "--dangerously-bypass-hook-trust", "-C", str(source)]
    if options.model:
        command += ["--model", options.model]
    started = time.monotonic()
    p = subprocess.run(command + [prompt], cwd=source, capture_output=True, text=True,
                       env=env, stdin=subprocess.DEVNULL, timeout=600)
    sessions.append({"request":prompt,"exit":p.returncode,"seconds":round(time.monotonic()-started,1)})
    if options.out:
        (options.out / ("session-%02d.txt" % len(sessions))).write_text("Request: " + prompt + "\n\n" + p.stdout + "\n" + p.stderr)
    check("agent request %d completed" % len(sessions), p.returncode == 0)

def put(path, data, mode=0o600):
    vm("python3", "-c", "import os,pathlib,sys;p=pathlib.Path(sys.argv[1]);p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(sys.stdin.buffer.read());os.chmod(p,int(sys.argv[2]))",
       path, str(mode), data=data)

def reader(variant, *args, **kwargs):
    root = remote + "/" + linux.name
    return vm("env", "CUB_CONFIG=" + remote + "/reader-" + variant,
              "CUB_CONTEXT=reader-" + variant, "PATH=" + root + "/bin:/usr/local/bin:/usr/bin:/bin",
              root + "/bin/cub", *args, **kwargs)

def service(variant):
    return "minihub-" + run_id + "-" + variant

def check(name, passed, detail=""):
    checks.append({"check": name, "pass": bool(passed)})
    print(("PASS " if passed else "FAIL ") + name + (": " + detail if detail else ""), flush=True)
    if not passed:
        raise RuntimeError(name)

def response(variant, post=False):
    script = """import json,pathlib,sys,urllib.request,urllib.error
port=pathlib.Path(sys.argv[1]).read_text().strip()
try:
 r=urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:'+port+'/',data=b'x'*2048 if sys.argv[2]=='post' else None),timeout=2)
 print(r.status if sys.argv[2]=='post' else r.read().decode())
except urllib.error.HTTPError as e: print(e.code)
"""
    return vm("python3", "-c", script, remote + "/" + variant + ".port", "post" if post else "get").stdout.decode().strip()

def state(variant, expected):
    end = time.monotonic() + 20
    while time.monotonic() < end:
        try:
            data = json.loads(response(variant))
            if all(str(data.get(k)).lower() == str(v).lower() for k, v in expected.items()):
                return data
        except (RuntimeError, ValueError):
            pass
        time.sleep(0.5)
    raise RuntimeError(variant + " did not reach " + str(expected))

def running_revision(variant):
    unit = json.loads(you("unit", "get", "app", "--space", app + "-" + variant, "-o", "json").stdout)
    unit = unit.get("Unit", unit)
    revision = unit["HeadRevisionNum"]
    raw = you("revision", "data", "app", str(revision), "--space", app + "-" + variant).stdout
    content = "\n".join(line for line in raw.decode().split("\n") if not line.strip().startswith("configHub.")).rstrip("\n") + "\n"
    loaded = json.loads(response(variant))["configuration"]
    check(variant + " serves the hub revision and matching settings", loaded == {
        "space": app + "-" + variant, "unit": "app", "revision": revision,
        "sha256": hashlib.sha256(content.encode()).hexdigest()})
    return loaded

try:
    assert (package / "bin/confighub-mini-app").is_file(), "host package missing"
    assert (linux / "bin/cub").is_file(), "Linux package missing"
    check("the existing target is a Linux VM", vm("uname", "-s").stdout.strip() == b"Linux", machine)
    userhome = vm("printenv", "HOME").stdout.decode().strip()
    assert userhome.startswith("/home/") and re.fullmatch(r"/home/[A-Za-z0-9_.-]+", userhome)
    remote = userhome + "/.confighub-mini-vm-service-" + run_id
    put(remote + "/.example-owner", run_id.encode())
    # OrbStack exposes the host's filesystem at /mnt/mac. Copying an existing
    # package keeps installation offline and avoids downloading with a secret.
    shared = "/mnt/mac" + str(linux)
    vm("cp", "-a", shared, remote + "/" + linux.name)
    cfg.mkdir()
    call([package / "bin/confighub-mini-app", "mini", "install-plugin", cfg], environment=env)
    installed = True
    started = you("mini", "install", "--name", hub, "--use").stdout.decode()
    server = re.search(r"http://127\.0\.0\.1:\d+", started).group(0).replace("127.0.0.1", "host.internal")
    source = work / app
    source.mkdir()
    (source / "app.env").write_text("MAX_BODY_BYTES=65536\nDEBUG=true\n")
    if options.agent:
        you("mini", "adopt", source)
        # Adoption proposes the app's initial values for live; the trusted
        # example bootstrap approves this baseline before the agent exists.
        # The later hardening is a separate proposal and approval.
        you("mini", "approve", app + "-base/adopt", "--yes", "--note", "Scripted example baseline, before the agent starts")
        you("mini", "require-approval", app, "--variant", "live", "--agent", "proposer", "--dir", source)
        (source / "AGENTS.md").write_text("""The platform runs this Python 3 stdlib API twice, with settings held by ConfigHub.
Write api.py. Read KEY=VALUE lines from APP_CONFIG on startup. Also read .cub-mini-pull.json beside it: files[the config filename] has unit, revision and sha256; space is at the top level. Refuse startup if the SHA-256 of the settings bytes does not match. Capture these once at startup as configuration={space,unit,revision,sha256}; do not reread on HTTP requests. Bind HTTP to 127.0.0.1 port 0 and write the chosen port to APP_PORT_FILE. GET / returns JSON with keys MAX_BODY_BYTES, DEBUG, configuration and instance (a UUID made once at startup). POST / consumes the request body and returns 413 if Content-Length exceeds MAX_BODY_BYTES, otherwise 200. Do not print or echo request bodies. The platform starts and supervises it; do not start a background service yourself. Keep app.env's current values. Use no third-party dependencies.
Your cub configuration contains only your proposal key. Change staging with cub mini set APP KEY=VALUE --variant staging --change-desc WHY (one setting per command). For production, change the base then create a change order under workflows/APP-live-approval. You cannot approve, promote to live or write it. Never use another sign-in. Do not change files in .claude, .cub-mini or your Codex settings.
""".replace("APP-live",app+"-live").replace("APP KEY",app+" KEY"))
        agent_request("Build a small booking API following AGENTS.md and the app.env settings. Leave api.py ready for the platform to run, and explain how it enforces the request limit. Do not change configuration or approve anything.")
        check("the first request produced the API", (source / "api.py").is_file())
        api = (source / "api.py").read_bytes()
    else:
        you("mini", "upload", source, "--variant", "live", "--change-desc", "The app already running, before hardening")
        you("variant", "create", "staging", app + "-base")
        you("mini", "require-approval", app, "--variant", "live", "--agent", "proposer")
        api = (here / "api.py").read_bytes()
    put(remote + "/api.py", api)
    for variant in ("staging", "live"):
        keyname = "reader-" + variant
        you("mini", "pull-key", keyname, app, "--variant", variant)
        vcfg = remote + "/" + keyname
        put(vcfg + "/reader.jwk", (cfg / "keys" / (keyname + ".jwk")).read_bytes())
        root = remote + "/" + linux.name
        vm(root + "/bin/confighub-mini-app", "mini", "install-plugin", vcfg)
        e = ["env", "CUB_CONFIG=" + vcfg]
        vm(*e, root + "/bin/cub", "auth", "login", "--new-context", "--private-key=" + vcfg + "/reader.jwk", "--server", server)
        context = json.loads(vm(*e, root + "/bin/cub", "context", "get", "-o", "json").stdout)["name"]
        vm(*e, root + "/bin/cub", "context", "rename", context, keyname)
        unit = "[Unit]\nDescription=ConfigHub mini isolated VM example\n[Service]\nExecStart=/usr/bin/python3 " + remote + "/api.py\nEnvironment=APP_CONFIG=" + remote + "/" + variant + "/app.env\nEnvironment=APP_PORT_FILE=" + remote + "/" + variant + ".port\nRestart=on-failure\nPrivateUsers=yes\nNoNewPrivileges=yes\nInaccessiblePaths=/mnt/mac\nRestrictAddressFamilies=AF_INET AF_INET6\n"
        put(userhome + "/.config/systemd/user/" + service(variant) + ".service", unit.encode())
    vm("systemctl", "--user", "daemon-reload")
    for variant in ("staging", "live"):
        args = ("mini", "pull", app, "--variant", variant, "--dir", remote + "/" + variant,
                "--restart", "systemctl --user restart " + service(variant))
        reader(variant, *args)
        reader(variant, *args, "--timer", "5s")
    state("staging", {"MAX_BODY_BYTES":65536}); state("live", {"MAX_BODY_BYTES":65536})
    check("both copies really serve requests", response("staging", True)=="200" and response("live",True)=="200")
    initial_live = running_revision("live")
    before = state("live", {"MAX_BODY_BYTES":65536})["instance"]
    reader("live", "mini", "pull", app, "--variant", "live", "--dir", remote + "/live", "--restart", "systemctl --user restart " + service("live"))
    check("an unchanged pull does not restart the service", state("live", {"MAX_BODY_BYTES":65536})["instance"] == before)
    if options.agent:
        agent_request("Try hardening " + app + ": set MAX_BODY_BYTES=1024 and DEBUG=false in staging only, using cub mini set with a reason. Leave base, live, code and local files unchanged; do not approve anything.")
    else:
        for setting in ("MAX_BODY_BYTES=1024", "DEBUG=false"):
            agent("mini", "set", app, setting, "--variant", "staging", "--change-desc", "Try a bounded request body and no debug output")
    state("staging", {"MAX_BODY_BYTES":1024,"DEBUG":"false"})
    check("hardening changes real staging behaviour only", response("staging",True)=="413" and response("live",True)=="200")
    if options.agent:
        agent_request("The staging checks passed. Propose those exact two settings for " + app + " live: set MAX_BODY_BYTES=1024 and DEBUG=false in the base with a reason, then create change order harden in " + app + "-base, with --in-scope-space " + app + "-live under workflows/" + app + "-live-approval. Do not approve, promote, write live, edit code or use another identity. Tell the person what waits.")
    else:
        for setting in ("MAX_BODY_BYTES=1024", "DEBUG=false"):
            agent("mini", "set", app, setting, "--variant", "base", "--change-desc", "Hardening tried in staging; keep existing application behaviour")
        agent("changeorder", "create", "--space", app + "-base", "harden", "--in-scope-space", app + "-live",
              "--change-workflow", "workflows/" + app + "-live-approval", "--description", "Bound request bodies; disable debug")
    check("the agent cannot approve its own proposal", agent("variant", "approve", app + "-base", "--change-order", app + "-base/harden", "--note", "approve myself", allowed=True).returncode != 0)
    check("the agent cannot write live directly", agent("function", "set", "--space", app + "-live", "--unit", "app", "--toolchain", "AppConfig/Env", "--change-desc", "bypass", "set-string-path", "*", "MAX_BODY_BYTES", "1024", allowed=True).returncode != 0)
    check("the pending proposal cannot be promoted", you("mini", "promote", app + "-live", "--change-order", app + "-base/harden", allowed=True).returncode != 0)
    check("production still accepts the original request", response("live",True)=="200")
    # Hold the timer so the deliberately failed restart below cannot race a
    # successful timer restart. The running API keeps its startup snapshot.
    vm("systemctl", "--user", "stop", "cub-mini-pull-" + app + "-live.timer", "cub-mini-pull-" + app + "-live.service")
    if options.interactive:
        print("Staging rejects the 2 KiB request (413); live still accepts it (200). Read the exact proposal below. Only you can approve it.", flush=True)
        p = subprocess.run([str(package / "bin/cub"), "mini", "approve", app + "-base/harden"], cwd=work, env=env)
        check("the terminal approval command completed", p.returncode == 0)
        held = you("unit", "data", "--space", app + "-live", "app").stdout.decode()
        if not re.search(r"(?m)^MAX_BODY_BYTES=1024$", held):
            declined = True
            check("declining approval left live unchanged", response("live",True)=="200")
            print("Nothing approved; live kept its original settings. Removing the isolated example.", flush=True)
            raise ApprovalDeclined()
    else:
        you("variant", "approve", app + "-base", "--change-order", app + "-base/harden", "--note", "Staging tested; approve this hardening revision (scripted test)")
        you("mini", "promote", app + "-live", "--change-order", app + "-base/harden")
    failed_restart = reader("live", "mini", "pull", app, "--variant", "live", "--dir", remote + "/live", "--restart", "false", allowed=True)
    on_disk = json.loads(vm("cat", remote + "/live/.cub-mini-pull.json").stdout)
    check("a failed restart leaves the original service running", failed_restart.returncode != 0 and on_disk.get("restartOwed") is True and json.loads(response("live"))["configuration"] == initial_live and response("live",True)=="200")
    reader("live", "mini", "pull", app, "--variant", "live", "--dir", remote + "/live")
    reader("live", "mini", "pull", app, "--variant", "live", "--dir", remote + "/live", "--restart", "systemctl --user restart " + service("live"))
    state("live", {"MAX_BODY_BYTES":1024,"DEBUG":"false"})
    check("the approved revision changes production behaviour", response("live",True)=="413")
    running_revision("live")
    check("the runtime's key cannot write its configuration", reader("live", "function", "set", "--space", app + "-live", "--unit", "app", "--toolchain", "AppConfig/Env", "--change-desc", "from runtime", "set-string-path", "*", "MAX_BODY_BYTES", "1", allowed=True).returncode != 0)
    # Roll back by proposing the earlier values as a new revision. The old
    # approval is not reused, and the agent still cannot ship the rollback.
    for setting in ("MAX_BODY_BYTES=65536", "DEBUG=true"):
        agent("mini", "set", app, setting, "--variant", "base", "--change-desc", "Roll back to the original example behaviour")
    agent("changeorder", "create", "--space", app + "-base", "rollback", "--in-scope-space", app + "-live", "--change-workflow", "workflows/" + app + "-live-approval", "--description", "Restore the original request limit and debug setting")
    check("rollback waits for a fresh approval", you("mini", "promote", app + "-live", "--change-order", app + "-base/rollback", allowed=True).returncode != 0 and response("live",True)=="413")
    if options.interactive:
        print("The hardened service is running. Review the rollback below; declining keeps the hardened service until example cleanup.", flush=True)
        p = subprocess.run([str(package / "bin/cub"), "mini", "approve", app + "-base/rollback"], cwd=work, env=env)
        check("the rollback approval command completed", p.returncode == 0)
        held = you("unit", "data", "--space", app + "-live", "app").stdout.decode()
        if not re.search(r"(?m)^MAX_BODY_BYTES=65536$", held):
            declined = True
            check("declining rollback leaves the hardened service unchanged", response("live",True)=="413")
            raise ApprovalDeclined()
    else:
        you("variant", "approve", app + "-base", "--change-order", app + "-base/rollback", "--note", "Restore the original behaviour (scripted test)")
        you("mini", "promote", app + "-live", "--change-order", app + "-base/rollback")
    reader("live", "mini", "pull", app, "--variant", "live", "--dir", remote + "/live", "--restart", "systemctl --user restart " + service("live"))
    state("live", {"MAX_BODY_BYTES":65536,"DEBUG":"true"})
    check("the approved rollback restores actual service behaviour", response("live",True)=="200")
    running_revision("live")
    complete = True
except ApprovalDeclined:
    complete = True
except Exception as error:
    checks.append({"check":"example completed", "pass":False, "error":str(error)})
    raise
finally:
    cleanup = True
    if remote:
        for variant in ("staging", "live"):
            timer = "cub-mini-pull-" + app + "-" + variant
            vm("systemctl", "--user", "disable", "--now", timer + ".timer", allowed=True)
            vm("systemctl", "--user", "stop", timer + ".service", service(variant) + ".service", allowed=True)
            for unit in (timer + ".timer",timer + ".service",service(variant) + ".service"):
                vm("rm", "-f", userhome + "/.config/systemd/user/" + unit, allowed=True)
        vm("systemctl", "--user", "daemon-reload", allowed=True)
        cleanup = vm("python3", "-c", "import pathlib,shutil,sys;p=pathlib.Path(sys.argv[1]);assert (p/'.example-owner').read_text()==sys.argv[2];shutil.rmtree(p)", remote, run_id, allowed=True).returncode == 0
        states = vm("systemctl", "--user", "is-active", *[service(v) + ".service" for v in ("staging","live")], *["cub-mini-pull-" + app + "-" + v + ".timer" for v in ("staging","live")], allowed=True)
        cleanup = cleanup and not any(s in ("active","activating","reloading") for s in states.stdout.decode().splitlines())
    if installed:
        removed = you("mini", "uninstall", "--name", hub, "--delete-data", allowed=True)
        cleanup = cleanup and (removed.returncode == 0 or not (cfg / "servers" / hub).exists())
    checks.append({"check":"temporary services, timers, files and hub removed", "pass":cleanup})
    print(("PASS " if cleanup else "FAIL ") + "temporary services, timers, files and hub removed", flush=True)
    complete = complete and cleanup
    result = {"complete":complete,"machine":machine,"platform":"OrbStack Linux VM on the development Mac", "real_agent_session":options.agent,"model":options.model,"sessions":sessions,"baseline_approval":"scripted fixture before the agent starts" if options.agent else "scripted fixture", "approval":"declined" if declined else ("terminal prompt outside agent" if options.interactive else "script using owner's key"), "checks":checks,"passed":sum(c["pass"] for c in checks),"failed":sum(not c["pass"] for c in checks)}
    if os.environ.get("VM_SERVICE_RESULT"):
        Path(os.environ["VM_SERVICE_RESULT"]).write_text(json.dumps(result,indent=2)+"\n")
    if options.out:
        (options.out / "result.json").write_text(json.dumps(result,indent=2)+"\n")
        if options.agent and source and (source / "api.py").exists():
            (options.out / "api.py").write_bytes((source / "api.py").read_bytes())
    shutil.rmtree(work)
    if not cleanup:
        raise RuntimeError("example cleanup failed; see the structured result")
